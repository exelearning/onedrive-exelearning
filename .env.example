# Microsoft Entra (Azure AD) application identifiers. The client ID is the
# Application (client) ID of the app registration. The tenant is the Microsoft
# Entra tenant; use "common" to support both work/school and personal accounts,
# "organizations" for any work/school tenant, "consumers" for personal
# accounts only, or your tenant id / domain to scope to a single tenant.
VITE_MS_CLIENT_ID=
VITE_MS_TENANT=common
