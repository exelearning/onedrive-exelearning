{
  "name": "onedrive-exelearning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html dist/404.html && mkdir -p dist/open dist/create && cp dist/index.html dist/open/index.html && cp dist/index.html dist/create/index.html",
    "preview": "vite preview",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "check": "biome check",
    "check:fix": "biome check --write",
    "ci": "biome ci",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "typescript": "^6.0.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
